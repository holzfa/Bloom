    val vec: Vector2<Int> = Vector2<Int>()

    val container = Container<Int>([1, 2, 3, 4, 5])
    val sum: Int = container.sum()

    assert(4.isEven())
    assert(!5.isOdd())

    val c1 = Complex(1.0, 2.0)
    val c2 = Complex(3.0, 4.0)
    val c3 = c1 + c2

    val resultStatus = Result.Success.toString()
    println(resultStatus)

    val dog = Dog()
    val sound: String = dog.speak()
    print("The Dog ${sound}'s")

    val person = Person(25)
    person.age = 30
    val formatted = formatPerson(person)

    val rangeSum: Int = (1..10).sum()

    val calc1: Int = calculate(5, 3)
    val calc2: Int = calculate(5)

    val pair: Pair<String, Int> = pairOf("test", 42)

    val nums: Array<Int> = [1, 2, 3, 4, 5]
    val filtered: Array<Int> = filter(nums) { it > 2 }

    sleepCycles(5)

    0
}