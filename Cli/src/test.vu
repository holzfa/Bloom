module Vura.Tests

import Vura.Test
from SuperTest import first, second, third

class Container<T> : Serializable {
    private prop items: Array<T> {
        get :> it
        set :> it = value
    }

    /*/ Creates a new Container instance /*/
    constructor(initial: Array<T>) {
        items = initial
    }

    /*/ Gets the first Item
     *  @Returns The first item of the container
    /*/
    fun first() -> T :> items[0]

    // Generic method
    fun map<U>(mapper: (T) -> U) -> Array<U> {
        val new = Array<U>(items.length)

        for (i in 0..items) {
            new[i] = mapper(items[i])
        }

        new
    }
}

trait Serializable<T> : Serializable {
    fun toString() -> String
}

struct Vector2<T>(var x: T, var y: T) : Serializable {
    impl fun toString() -> String {
        "Vector(x=${x}, y=${y})"
    }
}
struct IVec2 : Vector2<Int>

fun Container<Int>.sum() -> Int {
    var total = 0
    for (item in self.items) {
        total += item
    }

    total
}

prop Container<Int>.total: Int {
    get :> it.sum()
}

struct Pair<A, B>(val first: A, val second: B)

// Class with property accessors
class Person(age: Int) {
    prop age: Int {
        get :> it.clamp(120)
        set // this is the same as: set { it = value }
    }

    impl fun toString() -> String :> "Person aged ${person.age}"
}

// Virtual and sealed methods
class Animal {
    open fun speak() -> String {
        "Generic sound"
    }

    fun move() -> Bool {
        true
    }
}

class Dog : Animal {
    impl fun speak() -> String {
        "Woof"
    }
}

// Enum
enum Result(val code: Int?) [
    Success(0),
    Failure(1),
    Pending(null)
] {
    prop hasFailed { get :> self == Result.Failure }

    impl fun toString() -> String :> match (self) {
        Success :> "Success"
        Failure :> "Failed"
        Pending :> "In progress"
        else :> "Unknown"
    }
}

struct Optional<G>(val value: G?, val result: Result) {
    fun withValue(value: G) -> Optional<G> {
        Optional<G>(value, Result.Success)
    }

    fun empty() -> Optional<G> {
        Optional<G>(null, Result.Failure)
    }

    prop isDone: Bool { get :> result is Result.Success }
}


extensions Int {
    fun isEven() -> Bool {
        (self % 2) == 0
    }

    fun isOdd() -> Bool {
        (self % 2) != 0
    }

    object {
        const MaxValue: Int = 2_147_483_647
    }
}


struct Complex(val real: Float, val imaginary: Float) {
    fun +(other: Complex) -> Complex {
        Complex(real + other.real, imaginary + other.imaginary)
    }

    fun *(scalar: Float) -> Complex {
        Complex(real * scalar, imaginary * scalar)
    }

    fun *(other: Complex) -> Complex {
        Complex(real * other.real, imaginary * other.imaginary)
    }
}


fun filter<T>(items: Array<T>, predicate: (T) -> Bool) -> Array<T> {
    val new = List<T>(items.length)

    for (i in items) {
        if (predicate(i)) new.add(i)
    }

    return new
}


private fun sleepCycles(start: Int) {
    var counter: Int = start
    while (counter > 0) {
        counter -= 1
    }
}


fun pairOf<X, Y>(first: X, second: Y) -> Pair<X, Y> {
    Pair<X, Y>(first, second)
}


fun factorial(num: Int) -> Int {
    var sum: Int = 0
    for (i in 0..num) {
        sum += i
    }

    return sum
}

fun calculate(a: Int, b: Int) -> Int {
    a + b
}

fun calculate(a: Int) -> Int {
    a * 2
}


