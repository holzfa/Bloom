module Tests

trait Printable {
    fun toString(): String
}

struct Vector2<T> : Printable {
    var x: T
    var y: T

    impl fun toString() -> String {
        "Vector"
    }
}
struct IVec2 : Vector2<Int>

class Container<T> {
    private prop items: Array<T> {
        get() it
        set() it = value
    }

    Container(initial: Array<T>) {
        items = initial
    }

    // Method overloading
    fun get(index: Int) -> T {
        Items[index]
    }

    fun get() -> T {
        Items[0]
    }

    // Generic method
    fun Map<U>(mapper: (item: T) -> U) -> Array<U> {
        val new: Array<U> = Array(items.length)

        for (i in 0..#items) {
            new[i] = mapper(items[i])
        }

        new
    }
}

fun Container<Int>.Sum() -> Int {
    var total: Int = 0b000
    for (item in self.Items) {
        total += item
    }

    total
}

struct Pair<A, B> {
    val first: A
    val second: B
}

// Class with property accessors
class Person(age: Int) {
    prop age: Int {
        get() it
        set() it = value
    }
}

// Virtual and sealed methods
class Animal {
    open fun speak() -> String {
        "Generic sound"
    }

    fun move() -> Bool {
        true
    }
}

class Dog : Animal {
    impl fun Speak() -> String {
        "Woof"
    }
}

// Enum
enum Result {
    Success,
    Failure,
    Pending
}

struct Optional<G>(val value: G?, val result: Result) {
    static fun withValue(value: G) -> Optional<G> {
        Optional<G>(value, Result.Success)
    }

    static fun empty() -> Optional<G> {
        Optional<G>(null, Result.Failure)
    }

    prop isDone: Bool { get() result is Result.Success }
}


extensions Int {
    fun isEven() -> Bool {
        (self % 2) == 0
    }

    fun isOdd() -> Bool {
        (self % 2) != 0
    }
}


class Complex {
    val real: Float
    val imaginary: Float

    Complex(r: Float, i: Float) {
        real = r
        imaginary = i
    }

    fun +(other: Complex) -> Complex {
        Complex(real + other.real, imaginary + other.imaginary)
    }

    fun *(scalar: Float) -> Complex {
        Complex(real * scalar, imaginary * scalar)
    }
}


fun processResult(result: Result) -> String {
    match (result) {
        Result.Success => "Success"
        Result.Failure => "Failed"
        Result.Pending => "In progress"
        else => "Unknown"
    }
}


fun filter<T>(items: Array<T>, predicate: (item: T) -> Bool) -> T[] {
    val new = List<T>(items.length)

    for (i in items) {
        if (predicate(i)) new.add(i)
    }

    return new
}


private fun countdown(start: Int) {
    var counter: Int = start
    while (counter > 0) {
        counter -= 1
    }
}


fun pairOf<X, Y>(first: X, second: Y) -> Pair<X, Y> {
    Pair<X, Y>(first, second)
}


fun factorial(num: Int) -> Int {
    var sum: Int = 0
    for (i in 0..num) {
        sum += i
    }

    return sum
}


fun formatPerson(person: Person) -> String {
    return "Person aged ${person.age}"
}


fun calculate(a: Int, b: Int) -> Int {
    a + b
}

fun calculate(a: Int) -> Int {
    a * 2
}


fun main(args: Array<String>) -> Int {
    val vec: Vector2<Int> = Vector2<Int>()

    val container: Container<Int> = Container<Int>([1, 2, 3, 4, 5])
    val sum: Int = container.sum()

